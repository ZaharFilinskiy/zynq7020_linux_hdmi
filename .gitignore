# Vivado working data. Source BD/RTL/XDC and local IP repository are tracked.
/.Xil/
/*.cache/
/*.runs/
/*.hw/
/*.ip_user_files/
/*.sim/
/*.sdk/
/hdmi/.metadata/
/hdmi/.sdk/
/hdmi/RemoteSystemsTempFiles/
/hdmi/sdk_workspace/
/hdmi/.project
/hdmi/tests/build/
/hdmi/tests/pattern_build/
# Regenerated from design_1.bd and the local Module Reference RTL.
/zynq_linux.srcs/sources_1/bd/mref/
/zynq_linux.srcs/sources_1/bd/design_1/*
!/zynq_linux.srcs/sources_1/bd/design_1/design_1.bd
!/zynq_linux.srcs/sources_1/bd/design_1/hdl/
/zynq_linux.srcs/sources_1/bd/design_1/hdl/*
!/zynq_linux.srcs/sources_1/bd/design_1/hdl/design_1_wrapper.v
# Tool scratch files. Keep deliberate validation logs shipped with this release.
*.jou
*.log
*.str
*.pb
*.dcp
*.wdb
*.wcfg
*.backup.*
!/hdmi/export/linux_validation/*.log
# Historical exports are preserved on disk and in the pre-Linux ZIP archive.
/hdmi/export/validation_logs/
/hdmi/export/vivado_test/
/hdmi/export/BOOT_HDMI_TEST.bin
/hdmi/export/boot-hdmi-test.bif
/hdmi/export/hdmi_smoke.elf
/hdmi/export/methodology.rpt
