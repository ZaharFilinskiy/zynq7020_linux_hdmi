# Merge into the ACTUAL board kernel configuration, then run olddefconfig.
# Built-in drivers are required for a boot console (not modules).
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FONT_8x16=y
# Avoid simpledrm taking the same firmware framebuffer on newer kernels.
# CONFIG_DRM_SIMPLEDRM is not set
